# Supabase — anon key es pública por diseño, protegida por RLS.
# NUNCA pongas SUPABASE_SERVICE_ROLE_KEY, NOTION_TOKEN ni ningún secreto de servicio
# en el .env que lee Vite: todo lo que toca import.meta.env puede terminar en el bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
